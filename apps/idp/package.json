{
  "name": "pkauth-idp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pkauth IdP (passkey-demo + OIDC). Deploy is manual and out of scope for this change.",
  "scripts": {
    "build": "esbuild src/client.js --bundle --format=esm --minify --target=es2020 --outfile=public/app.js && esbuild src/admin.js --bundle --format=esm --minify --target=es2020 --outfile=public/admin.js",
    "dev": "wrangler dev",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
