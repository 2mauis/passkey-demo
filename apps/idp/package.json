  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "oauth4webapi": "^3.8.8",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "wrangler": "^4.152.0"
  }
}
