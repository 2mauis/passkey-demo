# 复制为 .dev.vars（已 gitignore）后本地 wrangler dev 使用。
# Turnstile 这两个是 Cloudflare 公开文档里的“总是通过”测试密钥；CHAL_HMAC_KEY / ADMIN_TOKEN 请本地随机生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RP_ID=localhost
ORIGIN=http://localhost:8787
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_ALLOW_TEST_KEYS=1
CHAL_HMAC_KEY=<PLACEHOLDER>
ADMIN_TOKEN=<PLACEHOLDER>
# OIDC 签名私钥（ES256 私钥 JWK）：占位值 = 未配置 → 所有 OIDC 端点 503。本地生成：node scripts/oidc-keygen.mjs .dev.vars
OIDC_SIGNING_KEY=<PLACEHOLDER>
